# Local-only settings. Copy to .env (git-ignored) and fill in.
# Password for the local SQL Server container's "sa" login (8+ chars, upper, lower, digit, symbol).
LOCAL_SQL_PASSWORD=
LOCAL_SQL_SERVER=localhost,1433
LOCAL_SQL_DATABASE=rul

# Filled in from the Bicep deployment outputs once Azure is up.
AZURE_SQL_SERVER=
AZURE_SQL_DATABASE=
MODEL_STORAGE_ACCOUNT_URL=

# Optional: require this key in the x-api-key header when running the API locally.
API_KEY=
